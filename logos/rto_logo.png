    <input type="hidden" name="ctl00$Main$hf2" id="ctl00_Main_hf2" />


    <script type="text/javascript">

        var panelSSOMicrosoftId = 'ctl00_Main_panelSSOMicrosoft';
        var panelSSOAgentLoginId = 'ctl00_Main_panelSSOAgentLogin';
        var panelLegacyLoginId = 'ctl00_Main_panelLegacyLogin';
        var divMicrosoftLoginWithOldLoginId = 'ctl00_Main_divMicrosoftLoginWithOldLogin';

        var panelSSOMicrosoft_ECAALL_Id = 'ctl00_Main_panelSSOMicrosoft_ECAALL';
        var panelSSOAgentLogin_ECAALL_Id = 'ctl00_Main_panelSSOAgentLogin_ECAALL';
        var divMicrosoftLogin_ECAALL_Id = 'ctl00_Main_divMicrosoftLogin_ECAALL';
        var divMicrosoftLoginWithOldLogin_ECAALL_Id = 'ctl00_Main_divMicrosoftLoginWithOldLogin_ECAALL';
        var pnllogin2_Id = 'ctl00_Main_pnllogin2';

        function setRole(role) {
            var hiddenField = document.getElementById('ctl00_Main_hfSSORole');
            const current = hiddenField.value;

            if (current === role) return; // Prevent unnecessary postbacks

            hiddenField.value = role;
            const options = document.querySelectorAll('.option');
            var lblLoginText = document.getElementById('ctl00_Main_lblLoginText');
            if (lblLoginText) lblLoginText.innerHTML = "";

            // Injected from backend
            const enforceSSOLoginForStaff = false;
            const enforceSSOLoginForStudent = false;


            // Example usage
            showPanelsBasedOnRole(role, enforceSSOLoginForStaff, enforceSSOLoginForStudent);
        }
        window.onload = function () {
             const enforceSSOLoginForStaff = false;
             const enforceSSOLoginForStudent = false;
             const isSSOIntegrationEnabled = false;
             const isSAMLEnabled = false;

              // Check which panel is visible
             var panelLogin = document.getElementById('ctl00_Main_panelLogin');
             var panelLogin_ECAALL = document.getElementById('ctl00_Main_panelLogin_ECAALL');
 
             var isECAALLVisible = panelLogin_ECAALL && panelLogin_ECAALL.style.display !== 'none';
             var isDefaultVisible = panelLogin && panelLogin.style.display !== 'none';

             // If SSO && SAML are not enabled, show traditional login by default
                if (isSSOIntegrationEnabled || isSAMLEnabled) 
                {
                     // Get the appropriate hidden field based on which panel is visible
                     var hfRole = null;
                     if (isECAALLVisible) {
                         hfRole = document.getElementById('ctl00_Main_hfSSORole_ECAALL');
                     } else if (isDefaultVisible) {
                         hfRole = document.getElementById('ctl00_Main_hfSSORole');
                     }
 
                     if (!hfRole) return; // Exit if neither control is found
 
                     var role = hfRole.value || "Staff"; // default to Staff if empty

                     // Apply active class to the correct set of options based on visible panel
                    if (isECAALLVisible) 
                    {
                        
                        const optionsECAALL = document.querySelectorAll('#ctl00_Main_panelSSORoleSelect_ECAALL .option');
                            optionsECAALL.forEach(option => {
                                if (option.getAttribute('data-role') === role) {
                                    option.classList.add('active');
                                     // Trigger the role-based panel visibility using the correct function
                                     const enforceSSOLoginForStaff = false;
                                     const enforceSSOLoginForStudent = false;
                                     showPanelsBasedOnRoleECAALL(role, enforceSSOLoginForStaff, enforceSSOLoginForStudent);
                                } else {
                                    option.classList.remove('active');
                                }
                            });
                    }
                    else
                    {
                        const options = document.querySelectorAll('.option');
                        options.forEach(option => {
                            if (option.getAttribute('data-role') === role) {
                                option.classList.add('active');
                            } else {
                                option.classList.remove('active');
                            }
                        });
                    } 
                }
                else
                {
                     if (isECAALLVisible) 
                    {
                        const pnllogin2 = document.getElementById(pnllogin2_Id);
                        const panelSSOMicrosoft_ECAALL = document.getElementById(panelSSOMicrosoft_ECAALL_Id);
                        const panelSSOAgentLogin_ECAALL = document.getElementById(panelSSOAgentLogin_ECAALL_Id);
                        const divMicrosoftLogin_ECAALL = document.getElementById(divMicrosoftLogin_ECAALL_Id);
                        const divMicrosoftLoginWithOldLogin_ECAALL = document.getElementById(divMicrosoftLoginWithOldLogin_ECAALL_Id);

                        if (pnllogin2) pnllogin2.style.display = 'block';
                        if (panelSSOMicrosoft_ECAALL) panelSSOMicrosoft_ECAALL.style.display = 'none';
                        if (panelSSOAgentLogin_ECAALL) panelSSOAgentLogin_ECAALL.style.display = 'none';
                        if (divMicrosoftLogin_ECAALL) divMicrosoftLogin_ECAALL.style.display = 'none';
                        if (divMicrosoftLoginWithOldLogin_ECAALL) divMicrosoftLoginWithOldLogin_ECAALL.style.display = 'none';
                    }
                    else
                    {
                        const panelLegacyLogin = document.getElementById(panelLegacyLoginId);
                        const panelSSOMicrosoft = document.getElementById(panelSSOMicrosoftId);
                        const panelSSOAgentLogin = document.getElementById(panelSSOAgentLoginId);
                        const divMicrosoftLoginWithOldLogin = document.getElementById(divMicrosoftLoginWithOldLoginId);
    
                        if (panelLegacyLogin) panelLegacyLogin.style.display = 'block';
                        if (panelSSOMicrosoft) panelSSOMicrosoft.style.display = 'none';
                        if (panelSSOAgentLogin) panelSSOAgentLogin.style.display = 'none';
                        if (divMicrosoftLoginWithOldLogin) divMicrosoftLoginWithOldLogin.style.display = 'none';
                    }
                }
            };
        

      
        function showPanelsBasedOnRole(role, enforceSSOLoginForStaff, enforceSSOLoginForStudent) {
            console.log(role);

            // Utility
            const get = (id) => document.getElementById(id);
            const setVisible = (el, show) => { if (el) el.style.display = show ? 'block' : 'none'; };

            // Map of controls with assumed ClientIDs from backend
            const panelSSOMicrosoft = get(panelSSOMicrosoftId);
            const panelSSOAgentLogin = get(panelSSOAgentLoginId);
            const panelLegacyLogin = get(panelLegacyLoginId);
            const divMicrosoftLoginWithOldLogin = get(divMicrosoftLoginWithOldLoginId);
            if (!panelSSOMicrosoft && !panelSSOAgentLogin && !divMicrosoftLoginWithOldLogin) {
                console.warn("SSO-related panels not found in DOM. Skipping role-based UI update.");
                return;
            }
            // Default: hide all
            setVisible(panelSSOMicrosoft, false);
            setVisible(panelSSOAgentLogin, false);
            setVisible(panelLegacyLogin, false);
            setVisible(divMicrosoftLoginWithOldLogin, false);

            if (role === "Agent" || role === "Employer" || role === "MeshedSupport") {
                setVisible(panelSSOAgentLogin, true);
            }
            else if (role === "Staff") {
                if (enforceSSOLoginForStaff) {
                    setVisible(panelSSOMicrosoft, true);
                } else {
                    setVisible(panelSSOAgentLogin, true);
                    setVisible(divMicrosoftLoginWithOldLogin, true);
                }
            }
            else if (role === "Student") {
                if (enforceSSOLoginForStudent) {
                    setVisible(panelSSOMicrosoft, true);
                } else {
                    setVisible(panelSSOAgentLogin, true);
                    setVisible(divMicrosoftLoginWithOldLogin, true);
                }
            }

            // Apply active role UI style (tab highlighting)
            setActiveRoleUI(role);
        }


        function setActiveRoleUI(role) {
            const divStaff = document.getElementById('ctl00_Main_divStaff');
            const divStudentRoleTab = document.getElementById('ctl00_Main_divStudentRoleTab');
            const divAgent = document.getElementById('ctl00_Main_divAgent');
            const divEmployer = document.getElementById('ctl00_Main_divEmployer');
            const divMeshedSupport = document.getElementById('ctl00_Main_divMeshedSupport');
            if (!divStaff || !divStudentRoleTab || !divAgent || !divEmployer) return;

            // Reset all
            divStaff.className = "option";
            divStudentRoleTab.className = "option";
            divAgent.className = "option";
            divEmployer.className = "option";
            divMeshedSupport.className = "option";
            switch (role) {
                case "Staff":
                    divStaff.className += " active";
                    break;
                case "Student":
                    divStudentRoleTab.className += " active";
                    break;
                case "Agent":
                    divAgent.className += " active";
                    break;
                case "Employer":
                    divEmployer.className += " active";
                    break;
                case "MeshedSupport":
                    divMeshedSupport.className += " active";
                    break;
            }
        }


        // ECAALL SSO Functions (complete version with panelSSOAgentLogin_ECAALL)
        

        function setRoleECAALL(role) {
            var hiddenField = document.getElementById('ctl00_Main_hfSSORole_ECAALL');
            const current = hiddenField.value;

            if (current === role) return; // Prevent unnecessary postbacks

            hiddenField.value = role;
            var lblLoginText_ECAALL_Unified = document.getElementById('ctl00_Main_lblLoginText_ECAALL_Unified');
            if (lblLoginText_ECAALL_Unified) lblLoginText_ECAALL_Unified.innerHTML = "";

            // Injected from backend
            const enforceSSOLoginForStaff = false;
            const enforceSSOLoginForStudent = false;

            // Show panels based on role for ECAALL
            showPanelsBasedOnRoleECAALL(role, enforceSSOLoginForStaff, enforceSSOLoginForStudent);
        }

        function showPanelsBasedOnRoleECAALL(role, enforceSSOLoginForStaff, enforceSSOLoginForStudent) {
            console.log("ECAALL Role: " + role);

            // Utility
            const get = (id) => document.getElementById(id);
            const setVisible = (el, show) => { if (el) el.style.display = show ? 'block' : 'none'; };

            // Get ECAALL controls
            const panelSSOMicrosoft_ECAALL = get(panelSSOMicrosoft_ECAALL_Id);
            const panelSSOAgentLogin_ECAALL = get(panelSSOAgentLogin_ECAALL_Id);
            const divMicrosoftLogin_ECAALL = get(divMicrosoftLogin_ECAALL_Id);
            const divMicrosoftLoginWithOldLogin_ECAALL = get(divMicrosoftLoginWithOldLogin_ECAALL_Id);
            const pnllogin2 = get(pnllogin2_Id);

            if (!panelSSOMicrosoft_ECAALL && !panelSSOAgentLogin_ECAALL && !divMicrosoftLogin_ECAALL) {
                console.warn("SSO-related panels not found in ECAALL DOM. Skipping role-based UI update.");
                return;
            }

            // Default: hide all
            setVisible(panelSSOMicrosoft_ECAALL, false);
            setVisible(panelSSOAgentLogin_ECAALL, false);
            setVisible(pnllogin2, false);
            setVisible(divMicrosoftLogin_ECAALL, false);
            setVisible(divMicrosoftLoginWithOldLogin_ECAALL, false);

            if (role === "Agent" || role === "Employer" || role === "MeshedSupport") {
                setVisible(panelSSOAgentLogin_ECAALL, true);
            }
            else if (role === "Staff") {
                if (enforceSSOLoginForStaff) {
                    setVisible(panelSSOMicrosoft_ECAALL, true);
                } else {
                    setVisible(panelSSOAgentLogin_ECAALL, true);
                    setVisible(divMicrosoftLoginWithOldLogin_ECAALL, true);
                }
            }
            else if (role === "Student") {
                if (enforceSSOLoginForStudent) {
                    setVisible(panelSSOMicrosoft_ECAALL, true);
                } else {
                    setVisible(panelSSOAgentLogin_ECAALL, true);
                    setVisible(divMicrosoftLoginWithOldLogin_ECAALL, true);
                }
            }

            // Apply active role UI style (tab highlighting)
            setActiveRoleUI_ECAALL(role);
        }

        function setActiveRoleUI_ECAALL(role) {
            const divStaff_ECAALL = document.getElementById('ctl00_Main_divStaff_ECAALL');
            const divStudentRoleTab_ECAALL = document.getElementById('ctl00_Main_divStudentRoleTab_ECAALL');
            const divAgent_ECAALL = document.getElementById('ctl00_Main_divAgent_ECAALL');
            const divEmployer_ECAALL = document.getElementById('ctl00_Main_divEmployer_ECAALL');
            const divMeshedSupport_ECAALL = document.getElementById('ctl00_Main_divMeshedSupport_ECAALL');

            if (!divStaff_ECAALL || !divStudentRoleTab_ECAALL || !divAgent_ECAALL || !divEmployer_ECAALL) return;

            // Reset all
            divStaff_ECAALL.className = "option";
            divStudentRoleTab_ECAALL.className = "option";
            divAgent_ECAALL.className = "option";
            divEmployer_ECAALL.className = "option";
            divMeshedSupport_ECAALL.className = "option";

            switch (role) {
                case "Staff":
                    divStaff_ECAALL.className += " active";
                    break;
                case "Student":
                    divStudentRoleTab_ECAALL.className += " active";
                    break;
                case "Agent":
                    divAgent_ECAALL.className += " active";
                    break;
                case "Employer":
                    divEmployer_ECAALL.className += " active";
                    break;
                case "MeshedSupport":
                    divMeshedSupport_ECAALL.className += " active";
                    break;
            }
        }
    </script>

    <style type="text/css">
        .options {
            display: flex;
            margin-bottom: 1em;
            border: 1px solid #ccc;
            border-radius: 6px;
            overflow: hidden;
            width: fit-content;
        }

        .option {
            padding: 0.5em 1.5em;
            cursor: pointer;
            background: #fff;
            border-right: 1px solid #ccc;
            color: #333;
            transition: background 0.3s;
        }

            .option:last-child {
                border-right: none;
            }

            .option.active {
                background: #666;
                color: #fff;
            }

        .microsoft-btn {
            height: 30px;
            display: flex;
            flex-direction: row;
            column-gap: 8px;
