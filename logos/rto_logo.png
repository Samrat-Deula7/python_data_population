    <script type="text/javascript">
        ////Script to prevent back button of the browser
        //function preventBack() { window.history.forward(); }
        //setTimeout("preventBack()", 0);
        //window.onunload = function () { null };
        ////END OF Script to prevent back button of the browser
        function IdExists(elements, id) {
            for (var i = 0; i < elements.length; i++) {

                if (elements[i].id.indexOf(id) > -1) {
                    return true;
                }
            }
            return false;
        }
        function EnableDisable(chkid) {
            var grid = chkid.parentNode.parentNode.parentNode.parentNode.parentNode;
            for (i = 0; i < grid.rows.length; i++) {
                var row = grid.rows[i];
                var items = row.getElementsByTagName('input');
                var itemsdrp = row.getElementsByTagName('select');


                if (itemsdrp.length > 0) {
                    if (IdExists(items, chkid.id)) {
                        var flagdrp = false;
                        for (j = 0; j < itemsdrp.length; j++) {

                            if (chkid.checked == true) {
                                itemsdrp[j].disabled = false;
                                break;
                            }
                            else if (chkid.checked == false) {
                                itemsdrp[j].disabled = true;
                                break;
                            }
                        }
                    }
                }
                if (items.length > 0) {
                    if (IdExists(items, chkid.id)) {
                        var flag = false;
                        for (j = 0; j < items.length; j++) {
                            if (items[j].type == 'checkbox') {
                                flag = true;
                            }
                            if (flag == true) {
                                if (items[j].type == 'text') {
                                    if (chkid.checked == true) {
                                        items[j].disabled = false;
                                    }
                                    else if (chkid.checked == false) {
                                        items[j].disabled = true;
                                    }

                                }
                                else if (items[j].type == 'radio') {
                                    if (chkid.checked == true) {
                                        items[j].disabled = false;
                                    }
                                    else if (chkid.checked == false) {
                                        items[j].disabled = true;
                                    }

                                }

                            }

                        }
                    }
                }
            }
        }
        document.addEventListener("input", function (e) {
            // Ensure it's a text input (ASP.NET TextBox renders as <input type="text">)
            if (e.target && e.target.tagName === "INPUT" && e.target.type === "text") {

                let input = e.target;
                let oldVal = input.value;
                let start = input.selectionStart;
                let end = input.selectionEnd;

                // Match spaces followed by "=" at the very start
                let newVal = oldVal.replace(/^\s*=/, "");

                if (newVal !== oldVal) {
                    let diff = oldVal.length - newVal.length;

                    input.value = newVal;

                    // Adjust caret so it stays near where user was typing
                    let newPos = Math.max(start - diff, 0);
                    input.setSelectionRange(newPos, newPos);

                    showWarning(input, "'=' is not allowed at the start");
                }
            }
        });

        // Helper function to show a small warning near input
        function showWarning(inputElem, message) {
            // Wrap input in a container if not wrapped yet, to position message
            if (!inputElem.parentElement.classList.contains('input-wrapper')) {
                const wrapper = document.createElement('span');
                wrapper.classList.add('input-wrapper');
                inputElem.parentNode.insertBefore(wrapper, inputElem);
                wrapper.appendChild(inputElem);
            }

            // Remove existing warning if present
            let existingWarning = inputElem.parentElement.querySelector('.input-warning');
            if (existingWarning) {
                clearTimeout(existingWarning.timeoutId);
                existingWarning.remove();
            }

            // Create warning message element
            let warning = document.createElement('div');
            warning.className = 'input-warning';
            warning.textContent = message;

            // Append to wrapper
            inputElem.parentElement.appendChild(warning);

            // Remove warning after 2 seconds
            warning.timeoutId = setTimeout(() => {
                warning.remove();
            }, 2000);
        }
        $(document).ready(function () {
            GetCheckedRows();
            function GetCheckedRows() {
                $(".gridCustomFieldscss tr").each(function (e) {
                    var checkBox = $(this).find("input[type='checkbox']");
                    if (checkBox.is(':checked')) {
                        $(checkBox).parent().parent().next().children().prop("disabled", false);
                        if ($(checkBox).parent().parent().next().children().find('input[type=radio]').length > 0) {
                            $(checkBox).parent().parent().next().children().removeAttr('disabled');
                            $(checkBox).parent().parent().next().children().parent().children().find(':disabled').removeAttr('disabled');
                        }
                    }
                });
            }
            // Back to top Scroller.
            $(window).scroll(function () {
                if ($(this).scrollTop() > 100) {
                    $('.scroll-up').fadeIn();
                } else {
                    $('.scroll-up').fadeOut();
                }
            });
            $('.scroll-up').click(function () {
                $("html, body").animate({ scrollTop: 0 }, 600);
                return false;
            });
        });



    </script>
    <style type="text/css">
        .scroll-up {
            width: 64px;
            height: 64px;
            opacity: 0.6;
            font-size: 11px;
            color: #fff;
            text-align: center;
            position: fixed;
            bottom: 5%;
            right: 50px;
            display: none;
            background: url('data:image/png;base64,') /*../../App_Themes/WecoTheme/images/scroll_up.png*/ no-repeat !important;
            *background: url('../../App_Themes/WecoTheme/images/scroll_up.png') no-repeat !important; /* For IE 6 and 7 */
            z-index: 9999999999999999 !important;
        }

            .scroll-up:hover {
                color: #fff;
                opacity: 1;
                -webkit-transition: opacity .5s ease-in-out;
                -moz-transition: opacity .5s ease-in-out;
                -ms-transition: opacity .5s ease-in-out;
                -o-transition: opacity .5s ease-in-out;
                transition: opacity .5s ease-in-out;
                z-index: 9999999999999999 !important;
            }

            .scroll-up span {
                opacity: 1;
                position: absolute;
                bottom: 0;
                right: 0;
                left: 0;
                text-align: center;
            }

            
        #pwdresetmodal .modalPopupLogin {
            height: 350px;
            width: 700px;
            background-image: url(/App_Themes/WecoTheme/images/login_bgr.png);
            background-repeat: no-repeat;
            background-size: cover;
        }
         .input-warning {
   color: red;
   font-size: 12px;
   margin-top: 2px;
   font-family: Arial, sans-serif;
   position: absolute;
   background: #fff8f8;
   border: 1px solid red;
   padding: 2px 6px;
   border-radius: 3px;
   z-index: 1000;
 }
 .input-wrapper {
   position: relative; /* for positioning warning inside */
   display: inline-block;
 }
    </style>
</head>
